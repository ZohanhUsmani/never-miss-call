# Never Miss a Call — SignalWire backend (updated from Twilio)
# Set these as environment variables in Render dashboard

SIGNALWIRE_SPACE=https://your-space.signalwire.com
SIGNALWIRE_PROJECT_ID=your_project_id_here
SIGNALWIRE_API_TOKEN=your_api_token_here
SIGNALWIRE_AREA_CODE=+1
SECRET_KEY=change-this-to-a-random-secret
SERVER_URL=https://your-app.onrender.com
DATABASE_URL=sqlite:///app.db

# Getting SignalWire credentials:
# 1. Sign up at https://signalwire.com/
# 2. Create a Space (your tenant URL is https://<your-space>.signalwire.com)
# 3. Go to API Keys → create a Project + API Token
# 4. Put the Space URL, Project ID, and API Token above
#
# SignalWire supports Pakistan numbers and many other countries.
# The API is Twilio-compatible — the backend uses the signalwire Python SDK.
